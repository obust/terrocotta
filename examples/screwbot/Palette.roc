## The Screwbot color palette: dark warehouse blues with cyan accents.
import tc.Color

import SceneRenderer

Palette := [].{

	ink : Color
	ink = 0xd8e5ff.Color

	muted : Color
	muted = 0x7584a3.Color

	surface : Color
	surface = 0x111a2e.Color

	surface_high : Color
	surface_high = 0x18243d.Color

	workspace : Color
	workspace = SceneRenderer.background

	grid : Color
	grid = 0x1a2943.Color

	cyan : Color
	cyan = 0x45d7ff.Color

	blue : Color
	blue = 0x5686ff.Color

	violet : Color
	violet = 0xa478ff.Color

	amber : Color
	amber = 0xffbe55.Color

	green : Color
	green = 0x57e389.Color

	red : Color
	red = 0xff647c.Color

	shadow : Color
	shadow = 0x03060d.Color
}
